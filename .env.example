# Google Maps SDK key — Google Cloud Console -> APIs & Services -> Credentials ->
# Create credentials -> API key. Enable "Maps SDK for Android" (and "Maps SDK
# for iOS" if you build for iPhone) on the same project. Restrict the key to
# Android apps: package com.sitetracker.app + your signing SHA-1.
# Used at build time (written into the Android manifest) AND read by the JS
# side, so changing it needs a rebuild, not just a Metro reload.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaxxxxxxxx

# From your Firebase project: Project settings -> General -> Your apps -> Web app
# (yes, "Web app" even though this is a mobile app — the JS SDK config is the same).
# These are safe to ship in the client bundle; real protection comes from
# Firestore/Realtime Database security rules, not from hiding these values.
EXPO_PUBLIC_FIREBASE_API_KEY=xxxxxxxx
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=xxxxxxxx.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=xxxxxxxx
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxxxxxx
EXPO_PUBLIC_FIREBASE_APP_ID=xxxxxxxx
# Realtime Database -> click "Create Database" -> copy the URL shown at the top.
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://xxxxxxxx.firebaseio.com

# Public dashboard origin for photo uploads. For testing, use an HTTPS preview
# origin that serves /api/photos/upload and uses the same Firebase project.
# The dashboard keeps the R2 keys on the server.
EXPO_PUBLIC_PHOTO_UPLOAD_API_URL=https://site-tracker-admin-web.vercel.app
