# Secret token (scope: Downloads:Read) from account.mapbox.com/access-tokens.
# Only used at build time to fetch the native Mapbox SDK — never bundled into the app.
# (app.config.ts also accepts RNMAPBOX_MAPS_DOWNLOAD_TOKEN, the name @rnmapbox/maps
# documents; if both are set, that one wins.)
MAPBOX_DOWNLOADS_TOKEN=sk.xxxxxxxx

# Default public token from account.mapbox.com/access-tokens.
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxx

# From your Firebase project: Project settings -> General -> Your apps -> Web app
# (yes, "Web app" even though this is a mobile app — the JS SDK config is the same).
# These are safe to ship in the client bundle; real protection comes from
# Firestore/Realtime Database security rules, not from hiding these values.
EXPO_PUBLIC_FIREBASE_API_KEY=xxxxxxxx
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=xxxxxxxx.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=xxxxxxxx
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxxxxxx
EXPO_PUBLIC_FIREBASE_APP_ID=xxxxxxxx
# Realtime Database -> click "Create Database" -> copy the URL shown at the top.
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://xxxxxxxx.firebaseio.com

# Photo files live in Supabase Storage, not Firebase Storage — Firebase
# Storage now requires a billing account (Blaze) for every project, even at
# free-tier usage (see CLAUDE.md). From your Supabase project: Project
# Settings -> Data API -> Project URL, and -> API Keys -> Publishable key.
# Also safe to ship in the client bundle; the "photos" Storage bucket is
# public-read by design (see README "Backend setup").
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=xxxxxxxx
