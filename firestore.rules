rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI logged into your project — see README).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() &&
        get(/databases/$(database)/documents/people/$(request.auth.uid)).data.appRole == 'owner';
    }

    // Roster: read by anyone signed in (the crew list + names are shared
    // context). Existing profiles and owner accounts are admin-SDK-only
    // (scripts/seedFirebase.js) — there's no in-app "edit employee" flow.
    // Self-signup (LoginScreen "Create account") is the one exception: a
    // brand-new user may create exactly their own profile, once, and only
    // as a worker — appRole can never be self-assigned to 'owner', however
    // the client dresses up the request. See peopleApi.createPersonProfile.
    match /people/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.appRole == 'worker'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.role is string
        && request.resource.data.color is string
        && request.resource.data.keys().hasOnly(['name', 'role', 'appRole', 'color']);
      allow update, delete: if false;
    }

    // Single site config. Only the owner can move the geofence.
    match /sites/{siteId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Photos: the owner sees everything; a worker sees only their own. A
    // read is allowed only when Firestore can *prove* the result set stays
    // within that limit, so a worker's query must carry
    // where('personId','==',uid) — an unfiltered list from a worker is
    // rejected outright rather than silently filtered. A worker can only
    // create photos attributed to themselves, and nothing is ever
    // edited/deleted from the client — it's meant to be an audit trail.
    match /photos/{photoId} {
      allow read: if isOwner() || (signedIn() && resource.data.personId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.personId == request.auth.uid;
      allow update, delete: if false;
    }

    // Activity feed: shared, append-only.
    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Expo push tokens, one doc per user. Separate from /people (which is
    // admin-only-write) so each signed-in device can register its own token.
    // Only the owner can read them (that's who a future Cloud Function would
    // notify).
    match /pushTokens/{uid} {
      allow read: if isOwner();
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
