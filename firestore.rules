rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI logged into your project — see README).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/people/$(request.auth.uid)).data;
    }

    // A deactivated person (people/{uid}.active == false) is treated as
    // signed out for every write below. Missing `active` means active.
    function isActive() {
      return signedIn() && me().get('active', true) != false;
    }

    function isOwner() {
      return isActive() && me().appRole == 'owner';
    }

    // Roster: read by anyone signed in (the crew list + names are shared
    // context). Owner accounts are created by the seed script only.
    //
    // Self-signup (LoginScreen "Create account"): a brand-new user may create
    // exactly their own profile, once, and only as a worker — appRole can
    // never be self-assigned to 'owner', however the client dresses up the
    // request. See peopleApi.createPersonProfile.
    //
    // Crew management (owner Crew screen): an owner may change someone's job
    // title, app role and active flag — nothing else — but never their own
    // appRole or active, so an owner can't demote or lock out themselves.
    // See peopleApi.updatePersonProfile.
    //
    // Profile tab: anyone active may change their own name and photo — and
    // only those two fields. The photo is a small inline JPEG data URI, capped
    // well below Firestore's 1 MB document limit. See peopleApi.updateOwnProfile. Deleting is still Admin-SDK-only;
    // deactivating is the in-app equivalent.
    match /people/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.appRole == 'worker'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.role is string
        && request.resource.data.color is string
        && request.resource.data.keys().hasOnly(['name', 'role', 'appRole', 'color']);
      // The admin dashboard also assigns sites and records contact details:
      // siteIds, email, phone, team, invitedAt (set when it invites someone).
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'appRole', 'active', 'siteIds', 'email', 'phone', 'team', 'invitedAt'])
        && request.resource.data.role is string
        && request.resource.data.role.size() > 0
        && request.resource.data.role.size() <= 60
        && request.resource.data.appRole in ['owner', 'worker']
        && request.resource.data.get('active', true) is bool
        && request.resource.data.get('siteIds', []) is list
        && (uid != request.auth.uid
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['appRole', 'active']));
      allow update: if isActive()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.get('avatar', '') is string
        && request.resource.data.get('avatar', '').size() <= 150000;
      allow delete: if false;
    }

    // Projects (name, code, status, manager, ...). No location. Everyone signed
    // in can read them (a worker picks one at check-in); only owners write.
    match /sites/{siteId} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Check-in sessions: one doc per continuous stretch of checked-in time.
    // A worker creates their own when they check in (or resume) and may later
    // only add `end` + `endReason`; owners read everything, workers their own.
    // Like photos, a worker's query must filter on personId. Never deleted.
    match /sessions/{sessionId} {
      allow read: if isOwner() || (signedIn() && resource.data.personId == request.auth.uid);
      allow create: if isActive()
        && request.resource.data.personId == request.auth.uid
        && request.resource.data.siteId is string
        && request.resource.data.start is number
        && !('end' in request.resource.data);
      allow update: if isActive()
        && resource.data.personId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['end', 'endReason'])
        && request.resource.data.endReason in ['signed-off', 'paused'];
      allow delete: if false;
    }

    // Photos: the owner sees everything; a worker sees only their own. A
    // read is allowed only when Firestore can *prove* the result set stays
    // within that limit, so a worker's query must carry
    // where('personId','==',uid) — an unfiltered list from a worker is
    // rejected outright rather than silently filtered. A worker can only
    // create photos attributed to themselves, and a record is never edited.
    // Only an owner may delete one (from the admin dashboard, which removes the
    // files first: deletePhotos in the dashboard's src/lib/admin.ts).
    //
    // 🚨🚨🚨 READ BEFORE CHANGING DELETE ON THIS COLLECTION 🚨🚨🚨
    // ❗ A photo is TWO files + ONE record. Whatever deletes a photo must delete
    //    the file, the _thumb.jpg thumbnail AND this Firestore record (it holds
    //    the path / URL). Delete only one and you leave a BROKEN IMAGE or an
    //    ORPHAN FILE behind. The project owner left this note for themselves.
    //    Full checklist: docs/READ-BEFORE-BUILDING-PHOTO-DELETION.md
    match /photos/{photoId} {
      allow read: if isOwner() || (signedIn() && resource.data.personId == request.auth.uid);
      allow create: if isActive() && request.resource.data.personId == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner();
    }

    // Inventory: one doc per item received at a site. The crew log what
    // arrives (only as themselves, only for a site they're assigned to) and
    // can never change or delete it afterwards; an owner can edit or delete
    // any entry from the admin dashboard. A worker reads only their own, so
    // their query must filter on personId (like photos). `resource == null`
    // lets the phone check whether an entry saved offline already reached
    // the server (a get of a doc that doesn't exist yet).
    function validInventory(data) {
      return data.siteId is string && data.siteId.size() > 0
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.quantity is number && data.quantity > 0 && data.quantity <= 1000000
        && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 20
        && data.receivedAt is number
        && data.get('note', '') is string && data.get('note', '').size() <= 300;
    }
    match /inventory/{entryId} {
      allow read: if isOwner()
        || (signedIn() && (resource == null || resource.data.personId == request.auth.uid));
      allow create: if isActive()
        && request.resource.data.personId == request.auth.uid
        && (isOwner() || request.resource.data.siteId in me().get('siteIds', []))
        && validInventory(request.resource.data)
        && request.resource.data.keys().hasOnly(['personId', 'personName', 'siteId', 'name', 'quantity', 'unit', 'note', 'receivedAt', 'createdAt']);
      allow update: if isOwner() && validInventory(request.resource.data);
      allow delete: if isOwner();
    }

    // Activity feed: shared, append-only.
    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if isActive();
      allow update, delete: if false;
    }

    // Expo push tokens, one doc per user. Separate from /people (which is
    // admin-only-write) so each signed-in device can register its own token.
    // Only the owner can read them (that's who a future Cloud Function would
    // notify).
    match /pushTokens/{uid} {
      allow read: if isOwner();
      allow write: if isActive() && request.auth.uid == uid;
    }
  }
}
